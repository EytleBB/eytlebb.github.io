[Unit]
Description=Back up and prune Eytle museum guestbook

[Service]
Type=oneshot
User=museum-guest
Group=museum-guest
EnvironmentFile=/etc/eytle-museum.env
ExecStart=/usr/bin/python3 -B /opt/eytle-museum/backup_guestbook.py
WorkingDirectory=/opt/eytle-museum
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/eytle-museum /var/backups/eytle-museum
MemoryMax=256M
