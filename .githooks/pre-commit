#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
# Content is owned by its own repositories, never regenerated in the site repo.
python3 - <<'PY'
import subprocess
paths = subprocess.check_output(['git', 'ls-files', '-z', '--', 'logs', 'images/gallery', 'images/gallery-preview', 'audio/museum.mp3']).decode().split('\0')
if any(paths):
    raise SystemExit('Personal content belongs in Eytle-Patch-Log or Eytle-Museum; see docs/maintenance/content-repositories.md')
PY
